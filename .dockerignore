# ==============================================================
# 构建上下文排除清单
# 作用有两个：一是别把 680MB 的 .venv 塞进构建上下文（每次 build 都要
# 打包上传，慢且大）；二是别把密钥烤进镜像层（镜像层删不掉，会被推送到仓库）。
# ==============================================================

# ---- 虚拟环境与字节码缓存 ----
.venv/
**/__pycache__/
**/*.py[cod]

# ---- 机密：只在运行时通过 env_file 注入 ----
.env
.claude/

# ---- 运行时产物：容器内会重新生成 / 由数据卷接管 ----
logs/

# ---- 版本控制与文档 ----
.git/
.gitignore
*.md
LICENSE

# ---- 与运行时无关的静态资源（assets/style.css 仍需保留，故只排除 png）----
assets/*.png

# ---- 编排文件自身不需要进镜像 ----
docker-compose.yml
.dockerignore
Dockerfile

# 注意：以下目录**故意不排除**，它们是运行时必需品
#   chroma_db/  —— 已构建好的向量库，会被预置到 /app/state/chroma
#   md5.txt     —— 与向量库绑定的去重台账
#   data/       —— 知识库源文件 + records.csv（db.init_db 的种子来源）
#   config/ prompts/ .streamlit/ assets/style.css
